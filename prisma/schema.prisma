// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// TRANSACTIONS & SALES
// ==========================================

model Transaction {
  id               Int             @id @default(autoincrement())
  date             DateTime        @default(now())
  grand_total      Decimal         @db.Decimal(10, 2)
  transaction_type TransactionType @default(RETAIL)

  customerId       Int?            // Optional for walk-in retail customers
  staffId          Int

  customer         Customer?       @relation(fields: [customerId], references: [id])
  staff            StaffUser       @relation(fields: [staffId], references: [id])

  transactionItems TransactionItem[]
  payments         Payment[]
  shipments        Shipment[]
  returns          Return[]
  exchanges        Exchange[]

  @@map("transaction")
}

model TransactionItem {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  productId      Int
  quantity_sold  Int
  applied_price  Decimal     @db.Decimal(10, 2)

  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id])

  @@map("transaction_item")
}

model Exchange {
  id               Int         @id @default(autoincrement())
  transactionId    Int
  productId        Int         // Product being exchanged
  quantity         Int         @default(1)
  date             DateTime    @default(now())
  price_difference Decimal     @db.Decimal(10, 2)
  is_within_7_days Boolean     @default(true)

  transaction      Transaction @relation(fields: [transactionId], references: [id])
  product          Product     @relation(fields: [productId], references: [id])

  @@map("exchange")
}

model Return {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  productId      Int         // Product being returned
  quantity       Int         @default(1)
  date           DateTime    @default(now())
  defect_reason  String
  refund_amount  Decimal     @db.Decimal(10, 2)
  staffId        Int

  transaction    Transaction @relation(fields: [transactionId], references: [id])
  product        Product     @relation(fields: [productId], references: [id])
  staff          StaffUser   @relation(fields: [staffId], references: [id])

  @@map("return")
}

// ==========================================
// PAYMENTS
// ==========================================

model Payment {
  id             Int            @id @default(autoincrement())
  transactionId  Int
  date           DateTime       @default(now())
  amount_paid    Decimal        @db.Decimal(10, 2)
  payment_method PaymentMethod

  cashPayment    CashPayment?
  gCashPayment   GCashPayment?
  creditPayment  CreditPayment?

  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model CashPayment {
  paymentId     Int     @id
  cash_tendered Decimal @db.Decimal(10, 2)
  change_given  Decimal @db.Decimal(10, 2)

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("cash_payment")
}

model GCashPayment {
  paymentId           Int     @id
  reference_number    String
  gcash_mobile_number String

  payment             Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("gcash_payment")
}

model CreditPayment {
  paymentId                Int      @id
  due_date                 DateTime
  remaining_credit_balance Decimal  @db.Decimal(10, 2)

  payment                  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("credit_payment")
}

// ==========================================
// SHIPMENT & FORWARDER
// ==========================================

model Shipment {
  id              Int            @id @default(autoincrement())
  transactionId   Int
  forwarderId     Int
  dispatch_date   DateTime       @default(now())
  tracking_status TrackingStatus @default(PENDING)

  transaction     Transaction    @relation(fields: [transactionId], references: [id])
  forwarder       Forwarder      @relation(fields: [forwarderId], references: [id])

  @@map("shipment")
}

model Forwarder {
  id                    Int        @id @default(autoincrement())
  company_name          String
  tracking_contact_info String

  shipments             Shipment[]

  @@map("forwarder")
}

// ==========================================
// USERS & CUSTOMERS
// ==========================================

model StaffUser {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  password_hash String
  first_name    String
  last_name     String
  assigned_role AssignedRole
  is_active     Boolean      @default(true)

  transactions   Transaction[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
  returns        Return[]

  @@map("staff_user")
}

model Customer {
  id             Int                @id @default(autoincrement())
  name           String
  contact_number String
  type           CustomerType       @default(RETAIL)
  
  wholesale      WholeSaleCustomer?
  transactions   Transaction[]

  createdAt      DateTime           @default(now())

  @@map("customer")
}

model WholeSaleCustomer {
  customerId          Int      @id
  credit_limit        Decimal  @db.Decimal(10, 2)
  outstanding_balance Decimal  @db.Decimal(10, 2) @default(0)
  company_name        String

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("wholesale_profile")
}

// ==========================================
// PRODUCT & INVENTORY
// ==========================================

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique // e.g. "Bolts", "Nuts", "Washers"
  products Product[]

  @@map("category")
}

model Product {
  id               Int       @id @default(autoincrement())
  name             String    // Descriptive name e.g. "Hex Bolt 1/2 x 2"
  categoryId       Int
  size_dimensions  String
  thread_type      String
  material_grade   String
  current_quantity Int       @default(0)
  reorder_point_ROP Int      @default(10)
  retail_price     Decimal   @db.Decimal(10, 2)
  wholesale_price  Decimal?  @db.Decimal(10, 2)
  
  binId            Int?      // Optional until assigned to a bin
  
  category         Category     @relation(fields: [categoryId], references: [id])
  bin_location     BinLocation? @relation(fields: [binId], references: [id])

  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  poItems          POItem[]
  returns          Return[]
  exchanges        Exchange[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("product")
}

model BinLocation {
  id             Int       @id @default(autoincrement())
  aisle_number   String
  shelf_location String

  products       Product[]

  @@map("bin_location")
}

model StockMovement {
  id               Int          @id @default(autoincrement())
  productId        Int
  date             DateTime     @default(now())
  type             MovementType
  quantity_changed Int
  reason           String
  staffId          Int

  product          Product      @relation(fields: [productId], references: [id])
  staff            StaffUser    @relation(fields: [staffId], references: [id])

  @@map("stock_movement")
}

// ==========================================
// PROCUREMENT & SUPPLIERS
// ==========================================

model PurchaseOrder {
  id          Int        @id @default(autoincrement())
  supplierId  Int
  order_date  DateTime   @default(now())
  po_status   POStatus   @default(PENDING)
  staffId     Int

  staff       StaffUser  @relation(fields: [staffId], references: [id])
  supplier    Supplier   @relation(fields: [supplierId], references: [id])

  deliveries  Delivery[]
  poItems     POItem[]

  @@map("purchase_order")
}

model POItem {
  id                 Int           @id @default(autoincrement())
  poId               Int
  productId          Int
  requested_quantity Int

  purchaseOrder      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])

  @@map("po_item")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contact_info   String
  location       String
  lead_time_days Int

  purchaseOrders PurchaseOrder[]

  @@map("supplier")
}

model Delivery {
  id            Int           @id @default(autoincrement())
  poId          Int
  delivery_date DateTime      @default(now())
  staffId       Int

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  staff         StaffUser     @relation(fields: [staffId], references: [id])

  @@map("delivery")
}

// ==========================================
// ENUMS
// ==========================================

enum TransactionType {
  RETAIL
  WHOLESALE
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum AssignedRole {
  MANAGER
  SECRETARY
  CASHIER
  SALES_CLERK
  STOCK_MANAGEMENT
}

enum PaymentMethod {
  CASH
  GCASH
  CREDIT
}

enum TrackingStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
}

enum POStatus {
  PENDING
  FULFILLED
}