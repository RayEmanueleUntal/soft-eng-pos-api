// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// TRANSACTIONS & SALES
// ==========================================

model Transaction {
  id               Int             @id @default(autoincrement())
  invoice_number   String?         @unique // Optional generated code (e.g., "INV-2026-0001")
  date             DateTime        @default(now())
  status           TransactionStatus @default(COMPLETED)
  transaction_type TransactionType @default(RETAIL)

  // Financial Breakdown
  subtotal         Decimal         @db.Decimal(10, 2)
  tax_total        Decimal         @default(0.00) @db.Decimal(10, 2)
  discount_total   Decimal         @default(0.00) @db.Decimal(10, 2)
  grand_total      Decimal         @db.Decimal(10, 2)
  
  // Foreign Keys
  customerId       Int?            // Optional for walk-in retail customers
  staffId          Int

  customer         Customer?       @relation(fields: [customerId], references: [id])
  staff            StaffUser       @relation(fields: [staffId], references: [id])

  transactionItems TransactionItem[]
  payments         Payment[]
  shipments        Shipment[]
  returns          Return[]
  exchanges        Exchange[]

  @@index([date])
  @@index([staffId])
  @@index([customerId])
  @@map("transaction")
}

model TransactionItem {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  productId      Int

  // Transaction Selling Details
  quantity_sold  Decimal     @db.Decimal(10, 3)
  unit_of_measure UnitOfMeasure   @default(PCS)    // e.g., "pcs", "kg", "box"

  // Conversion Snapshot at moment of sale
  uom_conversion_factor Decimal   @default(1.000) @db.Decimal(10, 3) // Multiplier used: 100.000
  base_quantity_deducted  Decimal @db.Decimal(10, 3) // Converted inventory deduction: 200.000 PCS 

  unit_price     Decimal     @db.Decimal(10, 2) // Base price per unit at moment of sale
  cost_price     Decimal     @default(0.00) @db.Decimal(10, 2) // Snapshot of unit cost at moment of sale
  discount       Decimal     @default(0.00) @db.Decimal(10, 2) // Line-item discount amount
  subtotal       Decimal     @db.Decimal(10, 2) // (quantity_sold * unit_price) - discount

  // Gross Profit = subtotal - (base_quantity_deducted x cost_price)

  // Relations
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_item")
}

model Exchange {
  id               Int         @id @default(autoincrement())
  transactionId    Int
  productId        Int         // Product being exchanged
  quantity         Decimal     @default(1.000) @db.Decimal(10, 3)
  date             DateTime    @default(now())
  price_difference Decimal     @db.Decimal(10, 2)
  is_within_7_days Boolean     @default(true)

  transaction      Transaction @relation(fields: [transactionId], references: [id])
  product          Product     @relation(fields: [productId], references: [id])

  @@map("exchange")
}

model Return {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  productId      Int         // Product being returned
  quantity       Decimal     @default(1.000) @db.Decimal(10, 3)
  date           DateTime    @default(now())
  defect_reason  String
  refund_amount  Decimal     @db.Decimal(10, 2)
  staffId        Int

  transaction    Transaction @relation(fields: [transactionId], references: [id])
  product        Product     @relation(fields: [productId], references: [id])
  staff          StaffUser   @relation(fields: [staffId], references: [id])

  @@map("return")
}

// ==========================================
// PAYMENTS
// ==========================================

model Payment {
  id             Int            @id @default(autoincrement())
  transactionId  Int
  date           DateTime       @default(now())
  amount_paid    Decimal        @db.Decimal(10, 2)
  payment_method PaymentMethod

  cashPayment    CashPayment?
  gCashPayment   GCashPayment?
  creditPayment  CreditPayment?

  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model CashPayment {
  paymentId     Int     @id
  cash_tendered Decimal @db.Decimal(10, 2)
  change_given  Decimal @db.Decimal(10, 2)

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("cash_payment")
}

model GCashPayment {
  paymentId           Int     @id
  reference_number    String
  gcash_mobile_number String

  payment             Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("gcash_payment")
}

model CreditPayment {
  paymentId                Int      @id
  due_date                 DateTime
  remaining_credit_balance Decimal  @db.Decimal(10, 2)
  status                   CreditStatus @default(UNPAID) 

  payment                  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([due_date])
  @@index([status])
  @@map("credit_payment")
}

// ==========================================
// CUSTOMER CREDIT & ACCOUNTS RECEIVABLE
// ==========================================

model CustomerPayment {
  id                      Int       @id @default(autoincrement())
  wholesaleCustId         Int
  staffId                 Int       // Cashier / Staff who collected the payment

  amount_paid             Decimal   @db.Decimal(10, 2)
  payment_method          PaymentMethod  // CASH, GCASH, CHECK, etc.
  reference_number        String?   // Check number, GCash ref, or bank deposit ref (if applies)

  payment_date            DateTime  @default(now())
  notes                   String?

  // Snapshots for Audit
  previous_balance        Decimal   @db.Decimal(10, 2) // Balance before payment
  new_balance             Decimal   @db.Decimal(10, 2) // Balance after payment

  wholeSaleProfile        WholeSaleCustomer  @relation(fields: [wholesaleCustId], references: [customerId], onDelete: Cascade)
  staff                   StaffUser @relation(fields: [staffId], references: [id])

  @@index([wholesaleCustId])
  @@index([payment_date])
  @@map("customer_payment")

}

// ==========================================
// SHIPMENT & FORWARDER
// ==========================================

model Shipment {
  id              Int            @id @default(autoincrement())
  transactionId   Int
  forwarderId     Int
  tracking_number String?
  dispatch_date   DateTime       @default(now())
  tracking_status TrackingStatus @default(PENDING)
  notes           String?       

  transaction     Transaction    @relation(fields: [transactionId], references: [id])
  forwarder       Forwarder      @relation(fields: [forwarderId], references: [id])  

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tracking_status])
  @@index([forwarderId])
  @@index([transactionId])
  @@index([dispatch_date])
  @@map("shipment")
}

model Forwarder {
  id                    Int        @id @default(autoincrement())
  company_name          String     @unique
  tracking_contact_info String
  is_active             Boolean    @default(true)

  shipments             Shipment[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([company_name])
  @@index([is_active])
  @@map("forwarder")
}

// ==========================================
// USERS & CUSTOMERS
// ==========================================

model StaffUser {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  password_hash String
  first_name    String
  last_name     String
  assigned_role AssignedRole
  is_active     Boolean      @default(true)

  transactions   Transaction[]
  customerPayments  CustomerPayment[]
  initiatedMovements StockMovement[] @relation("InitiatedMovements")
  approvedMovements  StockMovement[] @relation("ApprovedMovements")
  approvalRequests ApprovalRequest[] @relation("RequestedBy")
  reviewedRequests ApprovalRequest[] @relation("ReviewedBy")
  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
  returns        Return[]

  @@map("staff_user")
}

model Customer {
  id             Int                @id @default(autoincrement())
  name           String
  contact_number String
  type           CustomerType       @default(RETAIL)
  
  wholesale      WholeSaleCustomer?
  transactions   Transaction[]

  createdAt      DateTime           @default(now())

  @@index([name, contact_number])
  @@index([contact_number])
  @@map("customer")
}

model WholeSaleCustomer {
  customerId          Int      @id
  credit_limit        Decimal  @db.Decimal(10, 2)
  outstanding_balance Decimal  @db.Decimal(10, 2) @default(0)
  company_name        String

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerPayments    CustomerPayment[] // Linked directly to Wholesale Profile

  @@index([customerId])
  @@map("wholesale_profile")
}

// ==========================================
// PRODUCT & INVENTORY
// ==========================================

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique // e.g. "Bolts", "Nuts", "Washers"
  products Product[]

  @@map("category")
}

model Product {
  id               Int       @id @default(autoincrement())
  sku              String?   @unique // Shorthand code e.g. "BLT-m8-30-SS" or bin barcode
  name             String       // Descriptive Name. e.g. "Hex Bolt M8-1.25 x 30mm"
  categoryId       Int

  // Fastener-specific attributes (Nullable for non-threaded items like drill bits/tools)
  size_dimensions  String?      // e.g. "1/2 x 2" or "M8 x 30mm" 
  thread_type      String?      // e.g. "Coarse (UNC)", "Fine (UNF)", "M8x1.25"
  material_grade   String?      // e.g. "Stainless 304", "Grade 8", "Zinc Plated"

  // Inventory Tracking (Always in Base Units)
  base_uom         UnitOfMeasure    @default(PCS)  // "pcs", "kg", "meter"
  current_quantity Decimal   @default(0.00) @db.Decimal(10,3)
  reorder_point_ROP Decimal  @default(0.00) @db.Decimal(10,3)
  needsRecount     Boolean   @default(false) // Set to TRUE during forced stock-out overrides

  // Default Base Unit Pricing
  cost_price       Decimal   @default(0.00)   @db.Decimal(10, 2) // Purchasing cost per Base UoM
  // New Cost Price = ((Current Qty x Current Cost) + (Received Base Qty x New Unit Cost)) / (Current Qty + Received Base Qty) 
  retail_price     Decimal   @db.Decimal(10, 2) // Retail price per Base UoM
  wholesale_price  Decimal?  @db.Decimal(10, 2) // Wholesale price per Base UoM

  // Storage Location
  binId            Int?      // Link to BinLocation  
  
  // Relations
  category         Category     @relation(fields: [categoryId], references: [id])
  bin_location     BinLocation? @relation(fields: [binId], references: [id])

  // Configured Alternate Units of Measure for this product (e.g., Box, Sack, Bundle)
  uoms             ProductUom[]

  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  poItems          POItem[]
  deliveryItems    DeliveryItem[]
  returns          Return[]
  exchanges        Exchange[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([categoryId])
  @@index([name])
  @@index([binId])
  @@map("product")
}

model ProductUom {
  id              Int           @id @default(autoincrement())
  productId       Int
  uom             UnitOfMeasure

  // How many Base UoM units are inside 1 of this UoM?
  // e.g. If Base UoM is PCS, for BOX: conversion_factor = 100.00 (1 Box = 100 PCS)
  conversion_factor Decimal     @db.Decimal(10, 3)

  // Pricing Overrides for this specific package size (Optional: falls back to base_price * factor)
  cost_price      Decimal?      @db.Decimal(10, 2) // Quoted purchase price for 1 Box
  retail_price    Decimal?      @db.Decimal(10, 2) // Retail checkout price for 1 Box
  wholesale_price Decimal?      @db.Decimal(10, 2) // Wholesale checkout price for 1 Box

  is_default_purchase Boolean   @default(false) // Default unit selected on Purchase Orders
  is_default_sales    Boolean   @default(false) // Default unit selected at POS register

  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, uom])
  @@map("product_uom")

}

model BinLocation {
  id             Int       @id @default(autoincrement())
  aisle_number   String
  shelf_location String

  products       Product[]

  @@unique([aisle_number, shelf_location])
  @@map("bin_location")
}

model StockMovement {
  id               Int          @id @default(autoincrement())
  productId        Int
  staffId          Int          // Staff member who initiated/entered the movement
  approvedById     Int?         // Admin/Manager who authorized an override (if applicable)

  date             DateTime     @default(now())
  type             MovementType

  current_uom      UnitOfMeasure       @default(PCS)
  quantity_changed Decimal      @db.Decimal(10, 3)  // Positive for stock in, negative for stock out
  previous_quantity Decimal     @db.Decimal(10, 3)  // e.g., 0 (DB level before change)
  new_quantity     Decimal      @db.Decimal(10, 3)  // e.g., -2 (DB level after change)

  isOverride       Boolean      @default(false) // Flags if this bypassed normal stock limits
  reason           String       // e.g., "OVERRIDE_OUT_OF_STOCK: Customer bought physical item"


  // Relations
  product          Product      @relation(fields: [productId], references: [id])
  staff            StaffUser    @relation("InitiatedMovements", fields: [staffId], references: [id])
  approvedBy       StaffUser?   @relation("ApprovedMovements", fields: [approvedById], references: [id])

  @@index([productId])
  @@index([date])
  @@map("stock_movement")
}

// ==========================================
// PROCUREMENT & SUPPLIERS
// ==========================================

model PurchaseOrder {
  id          Int        @id @default(autoincrement())
  supplierId  Int
  order_date  DateTime   @default(now())
  po_status   POStatus   @default(PENDING)
  staffId     Int

  staff       StaffUser  @relation(fields: [staffId], references: [id])
  supplier    Supplier   @relation(fields: [supplierId], references: [id])

  deliveries  Delivery[]
  poItems     POItem[]

  @@index([supplierId])
  @@index([po_status])
  @@index([order_date])
  @@map("purchase_order")
}

model POItem {
  id                 Int           @id @default(autoincrement())
  poId               Int
  productId          Int

  // Ordering Quantities & Unit Conversion Snapshots
  requested_quantity Decimal       @db.Decimal(10, 3) // e.g., 2 (Sacks)
  ordered_uom        UnitOfMeasure @default(PCS) // Unit ordered on PO
  uom_conversion_factor Decimal    @default(1.000) @db.Decimal(10, 3) // Supplier-specific multiplier to Base UoM (e.g., 2000.000) 
  expected_base_quantity Decimal   @db.Decimal(10, 3) // requested_quantity * uom_conversion_factor

  unit_cost          Decimal       @db.Decimal(10, 2)  // Price quoted by supplier

  purchaseOrder      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
  @@unique([poId, productId])
  @@map("po_item")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  contact_person String?         // Representative contact name
  email          String?         // Valid contact email
  contact_number String?         // Mobile or telephone number
  location       String
  lead_time_days Int
  is_active      Boolean         @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@index([name])
  @@index([is_active])
  @@map("supplier")
}

model Delivery {
  id            Int           @id @default(autoincrement())
  poId          Int
  delivery_date DateTime      @default(now())
  staffId       Int

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  staff         StaffUser     @relation(fields: [staffId], references: [id])
  deliveryItems DeliveryItem[]

  @@index([poId])
  @@index([staffId])
  @@index([delivery_date])
  @@map("delivery")
}

model DeliveryItem {
  id            Int           @id @default(autoincrement())
  deliveryId    Int
  productId     Int

  // Receiving Quantities & Intake Base Yield Calculation
  received_quantity Decimal   @db.Decimal(10, 3)
  received_uom      UnitOfMeasure @default(PCS)
  uom_conversion_factor Decimal   @default(1.000) @db.Decimal(10, 3) // Multiplier used at intake
  actual_base_quantity  Decimal   @db.Decimal(10, 3) // Exact physical count added to Product.current_quantity

  delivery      Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([productId])
  @@map("delivery_item")
}

// ==========================================
// ADMIN-RELATED MODELS
// ==========================================

model ApprovalRequest {
  id           Int           @id @default(autoincrement())
  type         RequestType
  status       RequestStatus @default(PENDING)
  
  // Who asked?
  requestedById Int
  requestedBy   StaffUser    @relation("RequestedBy", fields: [requestedById], references: [id])
  
  // Who approved/rejected? (Nullable until resolved)
  reviewedById  Int?
  reviewedBy    StaffUser?   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  
  // Payload storing details needed to execute the action upon approval
  // e.g., { "productId": 12, "requestedDiscount": 15.00, "reason": "Damaged box" }
  payload      Json
  
  rejectionReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("approval_request")
}

model SystemSetting {
  key         String   @id // e.g., "RETURN_WINDOW_DAYS"
  value       String   // e.g., "14"
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

// ==========================================
// ENUMS
// ==========================================

enum RequestType {
  OVERRIDE_DISCOUNT
  STOCK_OUT_OVERRIDE
  DELETE_TRANSACTION
  REFUND_TRANSACTION
  EXCHANGE_TRANSACTION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum UnitOfMeasure {
  PCS
  BOX
  SET
  KG
  G
  METER
  HUNDRED
  GROSS 
  SACK
  SACKs // TEMP. MUST CLEAN THIS UP LATER
}

enum TransactionType {
  RETAIL
  WHOLESALE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum AssignedRole {
  ADMIN
  MANAGER
  SECRETARY
  CASHIER
  SALES_CLERK
  STOCK_MANAGEMENT
}

enum PaymentMethod {
  CASH
  GCASH
  CREDIT
}

enum TrackingStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

enum MovementType {
  IN
  OUT
  SALE
  RETURN
  ADJUSTMENT
}

enum POStatus {
  PENDING
  FULFILLED
  CANCELLED
  PARTIALLY_FULFILLED
}