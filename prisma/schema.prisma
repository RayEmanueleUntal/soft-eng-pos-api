// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// TRANSACTIONS & SALES
// ==========================================

model Transaction {
  id               Int             @id @default(autoincrement())
  invoice_number   String?         @unique // Optional generated code (e.g., "INV-2026-0001")
  date             DateTime        @default(now())
  status           TransactionStatus @default(COMPLETED)
  transaction_type TransactionType @default(RETAIL)

  // Financial Breakdown
  subtotal         Decimal         @db.Decimal(10, 2)
  tax_total        Decimal         @default(0.00) @db.Decimal(10, 2)
  discount_total   Decimal         @default(0.00) @db.Decimal(10, 2)
  grand_total      Decimal         @db.Decimal(10, 2)
  
  // Foreign Keys
  customerId       Int?            // Optional for walk-in retail customers
  staffId          Int

  customer         Customer?       @relation(fields: [customerId], references: [id])
  staff            StaffUser       @relation(fields: [staffId], references: [id])

  transactionItems TransactionItem[]
  payments         Payment[]
  shipments        Shipment[]
  returns          Return[]
  exchanges        Exchange[]

  @@index([date])
  @@index([staffId])
  @@index([customerId])
  @@map("transaction")
}

model TransactionItem {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  productId      Int

  // Use Decimal if selling loose items by weight (e.g., 2.5kg of nails). Keep Int if strictly by piece.
  quantity_sold  Decimal     @db.Decimal(10, 3)
  unit_of_measure String     @default("pcs")    // e.g., "pcs", "kg", "box"

  unit_price     Decimal     @db.Decimal(10, 2) // Base price per unit at moment of sale
  discount       Decimal     @default(0.00) @db.Decimal(10, 2) // Line-item discount amount
  subtotal       Decimal     @db.Decimal(10, 2) // (quantity_sold * unit_price) - discount

  // Relations
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_item")
}

model Exchange {
  id               Int         @id @default(autoincrement())
  transactionId    Int
  productId        Int         // Product being exchanged
  quantity         Int         @default(1)
  date             DateTime    @default(now())
  price_difference Decimal     @db.Decimal(10, 2)
  is_within_7_days Boolean     @default(true)

  transaction      Transaction @relation(fields: [transactionId], references: [id])
  product          Product     @relation(fields: [productId], references: [id])

  @@map("exchange")
}

model Return {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  productId      Int         // Product being returned
  quantity       Int         @default(1)
  date           DateTime    @default(now())
  defect_reason  String
  refund_amount  Decimal     @db.Decimal(10, 2)
  staffId        Int

  transaction    Transaction @relation(fields: [transactionId], references: [id])
  product        Product     @relation(fields: [productId], references: [id])
  staff          StaffUser   @relation(fields: [staffId], references: [id])

  @@map("return")
}

// ==========================================
// PAYMENTS
// ==========================================

model Payment {
  id             Int            @id @default(autoincrement())
  transactionId  Int
  date           DateTime       @default(now())
  amount_paid    Decimal        @db.Decimal(10, 2)
  payment_method PaymentMethod

  cashPayment    CashPayment?
  gCashPayment   GCashPayment?
  creditPayment  CreditPayment?

  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model CashPayment {
  paymentId     Int     @id
  cash_tendered Decimal @db.Decimal(10, 2)
  change_given  Decimal @db.Decimal(10, 2)

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("cash_payment")
}

model GCashPayment {
  paymentId           Int     @id
  reference_number    String
  gcash_mobile_number String

  payment             Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("gcash_payment")
}

model CreditPayment {
  paymentId                Int      @id
  due_date                 DateTime
  remaining_credit_balance Decimal  @db.Decimal(10, 2)

  payment                  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("credit_payment")
}

// ==========================================
// SHIPMENT & FORWARDER
// ==========================================

model Shipment {
  id              Int            @id @default(autoincrement())
  transactionId   Int
  forwarderId     Int
  dispatch_date   DateTime       @default(now())
  tracking_status TrackingStatus @default(PENDING)

  transaction     Transaction    @relation(fields: [transactionId], references: [id])
  forwarder       Forwarder      @relation(fields: [forwarderId], references: [id])

  @@map("shipment")
}

model Forwarder {
  id                    Int        @id @default(autoincrement())
  company_name          String
  tracking_contact_info String

  shipments             Shipment[]

  @@map("forwarder")
}

// ==========================================
// USERS & CUSTOMERS
// ==========================================

model StaffUser {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  password_hash String
  first_name    String
  last_name     String
  assigned_role AssignedRole
  is_active     Boolean      @default(true)

  transactions   Transaction[]
  initiatedMovements StockMovement[] @relation("InitiatedMovements")
  approvedMovements  StockMovement[] @relation("ApprovedMovements")
  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
  returns        Return[]

  @@map("staff_user")
}

model Customer {
  id             Int                @id @default(autoincrement())
  name           String
  contact_number String
  type           CustomerType       @default(RETAIL)
  
  wholesale      WholeSaleCustomer?
  transactions   Transaction[]

  createdAt      DateTime           @default(now())

  @@map("customer")
}

model WholeSaleCustomer {
  customerId          Int      @id
  credit_limit        Decimal  @db.Decimal(10, 2)
  outstanding_balance Decimal  @db.Decimal(10, 2) @default(0)
  company_name        String

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("wholesale_profile")
}

// ==========================================
// PRODUCT & INVENTORY
// ==========================================

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique // e.g. "Bolts", "Nuts", "Washers"
  products Product[]

  @@map("category")
}

model Product {
  id               Int       @id @default(autoincrement())
  sku              String?   @unique // Shorthand code e.g. "BLT-m8-30-SS" or bin barcode
  name             String       // Descriptive Name. e.g. "Hex Bolt M8-1.25 x 30mm"
  categoryId       Int

  // Fastener-specific attributes (Nullable for non-threaded items like drill bits/tools)
  size_dimensions  String?      // e.g. "1/2 x 2" or "M8 x 30mm" 
  thread_type      String?      // e.g. "Coarse (UNC)", "Fine (UNF)", "M8x1.25"
  material_grade   String?      // e.g. "Stainless 304", "Grade 8", "Zinc Plated"

  // Inventory & Auditing
  current_quantity Int       @default(0)
  reorder_point_ROP Int      @default(10)
  needsRecount     Boolean   @default(false) // Set to TRUE during forced stock-out overrides

  // Pricing
  retail_price     Decimal   @db.Decimal(10, 2)
  wholesale_price  Decimal?  @db.Decimal(10, 2)
  
  // Storage Location
  binId            Int?      // Link to BinLocation
  
  // Relations
  category         Category     @relation(fields: [categoryId], references: [id])
  bin_location     BinLocation? @relation(fields: [binId], references: [id])

  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  poItems          POItem[]
  returns          Return[]
  exchanges        Exchange[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([categoryId])
  @@index([name])
  @@index([binId])
  @@map("product")
}

model BinLocation {
  id             Int       @id @default(autoincrement())
  aisle_number   String
  shelf_location String

  products       Product[]

  @@map("bin_location")
}

model StockMovement {
  id               Int          @id @default(autoincrement())
  productId        Int
  staffId          Int          // Staff member who initiated/entered the movement
  approvedById     Int?         // Admin/Manager who authorized an override (if applicable)

  date             DateTime     @default(now())
  type             MovementType
  quantity_changed Int          // Positive for stock in, negative for stock out

  // Stock snapshot at the time of movement
  previous_quantity Int?        // e.g., 0 (DB level before change)
  new_quantity     Int?         // e.g., -2 (DB level after change)

  isOverride       Boolean      @default(false) // Flags if this bypassed normal stock limits
  reason           String       // e.g., "OVERRIDE_OUT_OF_STOCK: Customer bought physical item"


  // Relations
  product          Product      @relation(fields: [productId], references: [id])
  staff            StaffUser    @relation("InitiatedMovements", fields: [staffId], references: [id])
  approvedBy       StaffUser?   @relation("ApprovedMovements", fields: [approvedById], references: [id])

  @@index([productId])
  @@index([date])
  @@map("stock_movement")
}

// ==========================================
// PROCUREMENT & SUPPLIERS
// ==========================================

model PurchaseOrder {
  id          Int        @id @default(autoincrement())
  supplierId  Int
  order_date  DateTime   @default(now())
  po_status   POStatus   @default(PENDING)
  staffId     Int

  staff       StaffUser  @relation(fields: [staffId], references: [id])
  supplier    Supplier   @relation(fields: [supplierId], references: [id])

  deliveries  Delivery[]
  poItems     POItem[]

  @@map("purchase_order")
}

model POItem {
  id                 Int           @id @default(autoincrement())
  poId               Int
  productId          Int
  requested_quantity Int

  purchaseOrder      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])

  @@map("po_item")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contact_info   String
  location       String
  lead_time_days Int

  purchaseOrders PurchaseOrder[]

  @@map("supplier")
}

model Delivery {
  id            Int           @id @default(autoincrement())
  poId          Int
  delivery_date DateTime      @default(now())
  staffId       Int

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  staff         StaffUser     @relation(fields: [staffId], references: [id])

  @@map("delivery")
}

// ==========================================
// ENUMS
// ==========================================

enum TransactionType {
  RETAIL
  WHOLESALE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum AssignedRole {
  MANAGER
  SECRETARY
  CASHIER
  SALES_CLERK
  STOCK_MANAGEMENT
}

enum PaymentMethod {
  CASH
  GCASH
  CREDIT
}

enum TrackingStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

enum MovementType {
  IN
  OUT
  SALE
  RETURN
  ADJUSTMENT
}

enum POStatus {
  PENDING
  FULFILLED
}